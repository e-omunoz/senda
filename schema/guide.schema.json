{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-omunoz.github.io/senda/schema/guide.schema.json",
  "title": "Senda guide metadata (guide.toml)",
  "type": "object",
  "required": ["id", "title", "faction", "races", "classes", "sections"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "faction": { "enum": ["Alliance", "Horde"] },
    "races": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["Human", "Dwarf", "NightElf", "Gnome", "Orc", "Scourge", "Tauren", "Troll", "Skyborne"] }
    },
    "classes": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["WARRIOR", "PALADIN", "HUNTER", "ROGUE", "PRIEST", "SHAMAN", "MAGE", "WARLOCK", "DRUID"] }
    },
    "levels": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 60 }, "minItems": 2, "maxItems": 2 },
    "order": { "type": "integer" },
    "ship": { "type": "boolean", "description": "false: la guía se queda en data/ y no se compila en el addon" },
    "icon": { "type": ["string", "integer"] },
    "link": { "type": "string" },
    "author": { "type": "string" },
    "sections": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "pattern": "^(shared:)?[a-z0-9-]+$" }
    },
    "status": { "enum": ["verified", "unverified", "disputed"] },
    "sources": { "type": "array", "items": { "type": "string" } },
    "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string" }
  }
}
